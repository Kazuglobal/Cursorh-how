# AI Coding Tools Guide - 環境変数サンプル
# このファイルをコピーして .env.local を作成し、値を設定してください

# アプリケーション設定
NEXT_PUBLIC_BASE_URL=https://ai-coding-tools-guide.vercel.app
NEXT_PUBLIC_SITE_NAME="AI Coding Tools ガイド"
NEXT_PUBLIC_SITE_DESCRIPTION="Cursor、Claude、Manusなどの最新AIコーディングツールの使い方ガイド"

# Google Analytics
# Googleアナリティクス4のトラッキングIDを設定
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel環境変数
# Vercelで自動的に設定されるため、通常は編集不要
# VERCEL_URL=https://your-deployment.vercel.app

# データベース設定（将来の拡張用）
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_tools_guide

# API設定（将来の拡張用）
# API_SECRET_KEY=your-secret-key-here
# INTERNAL_API_TOKEN=your-internal-token

# 開発環境設定
NODE_ENV=development

# ローカル開発用ポート
# PORT=3000
